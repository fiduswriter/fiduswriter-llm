msgstr "Supprimez toutes les propositions de modification LLM du document."

#: llm/static/js/modules/llm/editor.js:146
msgid "Highlight LLM additions"
msgstr "Mettre en évidence les ajouts de LLM"

#: llm/static/js/modules/llm/editor.js:149
msgid "Highlight text that has been added by the LLM."
msgstr "Mettez en surbrillance le texte ajouté par le LLM."

#: llm/static/js/modules/llm/editor.js:168
msgid "Improve with LLM"
msgstr "Améliorer avec le LLM"

#: llm/static/js/modules/llm/editor.js:188
