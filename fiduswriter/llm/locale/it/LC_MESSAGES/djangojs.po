msgstr "Istruzioni"

#: llm/static/js/modules/llm/templates.js:57
msgid "e.g. Fix the grammar in this text"
msgstr "per esempio. Correggi la grammatica in questo testo"

#: llm/static/js/modules/llm/templates.js:62
msgid "Output mode"
msgstr "Modalità di uscita"

#: llm/static/js/modules/llm/templates.js:70
msgid "Review proposed changed before applying (right-click)"
msgstr ""
"Esamina la proposta modificata prima di applicarla (clic con il pulsante "
"destro del mouse)"

#: llm/static/js/modules/llm/templates.js:74
