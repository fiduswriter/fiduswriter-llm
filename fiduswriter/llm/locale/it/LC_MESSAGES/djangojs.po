msgstr "Applicare le proposte direttamente al documento"

#: llm/static/js/modules/llm/templates.js:78
msgid "Apply proposals as tracked changes"
msgstr "Applicare le proposte come modifiche tracciate"

#: llm/static/js/modules/llm/templates.js:82
