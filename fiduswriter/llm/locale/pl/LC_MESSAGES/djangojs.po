msgstr "ustęp"

#: llm/static/js/modules/llm/editor.js:31
#: llm/static/js/modules/llm/editor.js:32
#: llm/static/js/modules/llm/editor.js:33
#: llm/static/js/modules/llm/editor.js:34
#: llm/static/js/modules/llm/editor.js:35
