msgstr "Zastosuj jako prześledzoną zmianę"

#: llm/static/js/modules/llm/review_dialog.js:35
msgid "Ignore"
msgstr "Ignorować"

#: llm/static/js/modules/llm/templates.js:4
msgid "citation"
msgstr "cytat"

#: llm/static/js/modules/llm/templates.js:5
msgid "equation"
msgstr "równanie"

#: llm/static/js/modules/llm/templates.js:6
msgid "cross-reference"
msgstr "odsyłacz"

#: llm/static/js/modules/llm/templates.js:7
msgid "footnote"
msgstr "notatka"

#: llm/static/js/modules/llm/templates.js:16
msgid "non-text element"
msgstr "element nietekstowy"

#: llm/static/js/modules/llm/templates.js:52
