#: llm/static/js/modules/llm/dialog.js:16
msgid "Improve text with LLM"
msgstr "Popraw tekst za pomocą LLM"

#: llm/static/js/modules/llm/dialog.js:24
msgid "Improve"
msgstr "Poprawić"

#: llm/static/js/modules/llm/dialog.js:114
msgid "Please enter instructions."
msgstr "Proszę wprowadzić instrukcje."

#: llm/static/js/modules/llm/dialog.js:137
msgid "Please enter a valid maximum length difference percentage."
msgstr "Wprowadź prawidłowy procent różnicy maksymalnej długości."

#: llm/static/js/modules/llm/dialog.js:165
msgid "Please enter a valid minimum word difference percentage."
msgstr "Wprowadź prawidłowy minimalny procent różnicy słów."

