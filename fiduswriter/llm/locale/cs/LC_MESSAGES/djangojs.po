msgstr "Použít návrhy jako sledované změny"

#: llm/static/js/modules/llm/templates.js:82
msgid "Add LLM suggestions as comments on the text"
msgstr "Přidejte návrhy LLM jako komentáře k textu"

#: llm/static/js/modules/llm/templates.js:86
msgid "Add a single comment on the entire document"
msgstr "Přidejte jeden komentář k celému dokumentu"

#: llm/static/js/modules/llm/templates.js:93
msgid "Quality checks"
msgstr "Kontroly kvality"

#: llm/static/js/modules/llm/templates.js:96
msgid "LLM is expected to translate the text to another language"
msgstr "Očekává se, že LLM přeloží text do jiného jazyka"

#: llm/static/js/modules/llm/templates.js:100
msgid "Reject paragraphs/headings whose length differs by more than"
msgstr "Odmítněte odstavce/nadpisy, jejichž délka se liší o více než"

#: llm/static/js/modules/llm/templates.js:102
msgid "from the original"
msgstr "z originálu"

#: llm/static/js/modules/llm/templates.js:106
msgid "Require every paragraph/heading to be modified by the LLM"
msgstr "Vyžadovat úpravu každého odstavce/nadpisu LLM"

#: llm/static/js/modules/llm/templates.js:110
msgid "Reject paragraphs/headings where fewer than"
msgstr "Odmítněte odstavce/nadpisy, kde je méně než"

#: llm/static/js/modules/llm/templates.js:112
msgid "of words differ from the original"
msgstr "slov se liší od originálu"

#: llm/static/js/modules/llm/templates.js:118
msgid "Text to improve"
msgstr "Text ke zlepšení"

#: llm/static/js/modules/llm/templates.js:134
msgid "Original text"
msgstr "Původní text"

#: llm/static/js/modules/llm/templates.js:146
msgid "Proposed text by"
msgstr "Navrhovaný text od"

#: llm/static/js/modules/llm/templates.js:160
msgid "LLM settings"
msgstr "nastavení LLM"

#: llm/static/js/modules/llm/templates.js:162
msgid ""
"Configure the API key, URL and model for your preferred LLM service. The URL"
" should point to an OpenAI-compatible chat completions endpoint."
msgstr ""
"Nakonfigurujte klíč API, adresu URL a model pro vaši preferovanou službu "
"LLM. Adresa URL by měla ukazovat na koncový bod dokončení chatu kompatibilní"
" s OpenAI."

#: llm/static/js/modules/llm/templates.js:164
msgid "API URL"
msgstr "URL rozhraní API"

#: llm/static/js/modules/llm/templates.js:168
msgid "API key"
msgstr "API klíč"

#: llm/static/js/modules/llm/templates.js:169
msgid "Using server-provided API key"
msgstr "Pomocí klíče API poskytnutého serverem"

#: llm/static/js/modules/llm/templates.js:169
msgid "Your API key"
msgstr "Váš klíč API"

#: llm/static/js/modules/llm/templates.js:170
msgid "Leave empty to use the API key provided by the server operator."
msgstr ""
"Chcete-li použít klíč API poskytnutý operátorem serveru, ponechte prázdné."

#: llm/static/js/modules/llm/templates.js:174
msgid "Fetch models"
msgstr "Vyzvedněte modely"

#: llm/static/js/modules/llm/templates.js:179
