msgstr "Introduzca un porcentaje de diferencia de longitud máxima válido."

#: llm/static/js/modules/llm/dialog.js:165
msgid "Please enter a valid minimum word difference percentage."
msgstr "Ingrese un porcentaje mínimo de diferencia de palabras válido."

