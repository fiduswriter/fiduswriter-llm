#: llm/static/js/modules/llm/templates.js:106
msgid "Require every paragraph/heading to be modified by the LLM"
msgstr "Требовать, чтобы каждый абзац/заголовок был изменен LLM"

#: llm/static/js/modules/llm/templates.js:110
msgid "Reject paragraphs/headings where fewer than"
msgstr "Отклонять абзацы/заголовки, в которых меньше"

#: llm/static/js/modules/llm/templates.js:112
msgid "of words differ from the original"
msgstr "слов отличаются от оригинала"

#: llm/static/js/modules/llm/templates.js:118
msgid "Text to improve"
msgstr "Текст для улучшения"

#: llm/static/js/modules/llm/templates.js:134
