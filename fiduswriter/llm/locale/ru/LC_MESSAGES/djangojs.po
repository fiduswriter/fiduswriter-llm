msgstr "Ваш API-ключ"

#: llm/static/js/modules/llm/templates.js:170
msgid "Leave empty to use the API key provided by the server operator."
msgstr ""
"Оставьте пустым, чтобы использовать ключ API, предоставленный оператором "
"сервера."

#: llm/static/js/modules/llm/templates.js:174
msgid "Fetch models"
msgstr "Получить модели"

#: llm/static/js/modules/llm/templates.js:179
msgid "Model"
msgstr "Модель"

#: llm/static/js/modules/llm/templates.js:181
msgid "Fetch models first"
msgstr "Сначала выберите модели"

#: llm/static/js/modules/llm/templates.js:183
msgid "Or enter model name manually"
msgstr "Или введите название модели вручную"
