msgstr "Använder serverlevererad API-nyckel"

#: llm/static/js/modules/llm/templates.js:169
msgid "Your API key"
msgstr "Din API-nyckel"

#: llm/static/js/modules/llm/templates.js:170
msgid "Leave empty to use the API key provided by the server operator."
msgstr "Lämna tomt för att använda API-nyckeln från serveroperatören."

