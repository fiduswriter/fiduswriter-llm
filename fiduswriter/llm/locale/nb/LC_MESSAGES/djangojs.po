msgstr "Kvalitetssjekker"

#: llm/static/js/modules/llm/templates.js:96
msgid "LLM is expected to translate the text to another language"
msgstr "LLM forventes å oversette teksten til et annet språk"

#: llm/static/js/modules/llm/templates.js:100
msgid "Reject paragraphs/headings whose length differs by more than"
msgstr "Avvis avsnitt/overskrifter hvis lengde avviker med mer enn"

#: llm/static/js/modules/llm/templates.js:102
msgid "from the original"
msgstr "fra originalen"

#: llm/static/js/modules/llm/templates.js:106
msgid "Require every paragraph/heading to be modified by the LLM"
msgstr "Krev at hvert avsnitt/overskrift skal endres av LLM"

#: llm/static/js/modules/llm/templates.js:110
msgid "Reject paragraphs/headings where fewer than"
msgstr "Avvis avsnitt/overskrifter der færre enn"

#: llm/static/js/modules/llm/templates.js:112
msgid "of words differ from the original"
msgstr "ord skiller seg fra originalen"

#: llm/static/js/modules/llm/templates.js:118
msgid "Text to improve"
msgstr "Tekst for å forbedre"

#: llm/static/js/modules/llm/templates.js:134
