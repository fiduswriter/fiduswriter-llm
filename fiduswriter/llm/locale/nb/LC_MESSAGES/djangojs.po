msgstr "Angi en gyldig prosentandel for maksimal lengdeforskjell."

#: llm/static/js/modules/llm/dialog.js:165
msgid "Please enter a valid minimum word difference percentage."
msgstr "Angi en gyldig minimumsprosent for ordforskjell."

