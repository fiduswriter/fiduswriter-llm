msgstr "Behandler blok %s af %s..."

#: llm/static/js/modules/llm/editor.js:622
#: llm/static/js/modules/llm/editor.js:1961
msgid "Done"
msgstr "Færdig"

#: llm/static/js/modules/llm/editor.js:627
msgid "LLM comments added."
msgstr "LLM kommentarer tilføjet."

#: llm/static/js/modules/llm/editor.js:631
msgid "LLM proposals created. Right-click a highlighted passage to review."
msgstr ""
"LLM-forslag oprettet. Højreklik på en fremhævet passage for at gennemgå."

#: llm/static/js/modules/llm/editor.js:633
msgid "No LLM change proposals were necessary."
msgstr "Det var ikke nødvendigt med forslag til LLM-ændringer."

#: llm/static/js/modules/llm/editor.js:634
msgid "LLM improvement applied."
msgstr "LLM forbedring anvendt."

#: llm/static/js/modules/llm/editor.js:639
msgid "LLM improvement cancelled."
msgstr "LLM forbedring annulleret."

#: llm/static/js/modules/llm/editor.js:643
msgid "Could not apply LLM improvement."
msgstr "Kunne ikke anvende LLM-forbedring."

#: llm/static/js/modules/llm/editor.js:661
msgid "text passage"
msgstr "tekst passage"

#: llm/static/js/modules/llm/editor.js:666
msgid "You are editing a"
msgstr "Du redigerer en"

#: llm/static/js/modules/llm/editor.js:668
msgid ""
"Keep it as a heading: concise, preferably not a full sentence, and suitable "
"as a section title."
msgstr ""
"Hold det som overskrift: kortfattet, helst ikke en hel sætning, og velegnet "
"som afsnitstitel."

#: llm/static/js/modules/llm/editor.js:671
msgid "Keep it as a document title: concise and not a full sentence."
msgstr "Hold det som en dokumenttitel: kortfattet og ikke en hel sætning."

#: llm/static/js/modules/llm/editor.js:674
msgid ""
"Only fix obvious typos or formatting issues in the code; do not change the "
"logic."
msgstr ""
"Ret kun åbenlyse stavefejl eller formateringsproblemer i koden; ændre ikke "
"logikken."

#: llm/static/js/modules/llm/editor.js:677
msgid "Context before this passage:"
msgstr "Kontekst før denne passage:"

#: llm/static/js/modules/llm/editor.js:680
msgid "Context after this passage:"
msgstr "Kontekst efter denne passage:"

#: llm/static/js/modules/llm/editor.js:684
msgid "The text contains placeholders such as"
msgstr "Teksten indeholder pladsholdere som f.eks"

#: llm/static/js/modules/llm/editor.js:684
msgid ""
"representing non-text elements (citations, equations, cross-references). You"
" MUST preserve these placeholders exactly and in the same order. Do not "
"modify them. Only improve the surrounding text."
msgstr ""
"repræsenterer ikke-tekstlige elementer (citater, ligninger, "
"krydshenvisninger). Du SKAL bevare disse pladsholdere nøjagtigt og i samme "
"rækkefølge. Modificer dem ikke. Forbedre kun den omgivende tekst."

#: llm/static/js/modules/llm/editor.js:688
msgid ""
"The text also contains formatting markers such as "
"[MARK:strong:0]...[/MARK:strong:0] for bold, [MARK:em:0]...[/MARK:em:0] for "
"italic, [MARK:link:0]...[/MARK:link:0] for links, and "
"[MARK:comment:0]...[/MARK:comment:0] for comments. You MUST preserve these "
"markers exactly. Do not modify them."
msgstr ""
"Teksten indeholder også formateringsmarkører såsom "
"[MARK:strong:0]...[/MARK:strong:0] for fed, [MARK:em:0]...[/MARK:em:0] for "
"kursiv, [MARK:link:0]...[/MARK:link:0] for links og "
"[MARK:comment:0]...[/MARK:comment:0] for kommentarer. Du SKAL bevare disse "
"markører nøjagtigt. Modificer dem ikke."

#: llm/static/js/modules/llm/editor.js:697
msgid ""
"Do not rewrite the text. Instead, briefly explain what could be improved "
"about it. Respond with one or more short comments, one per line."
msgstr ""
"Du må ikke omskrive teksten. Forklar i stedet kort, hvad der kunne forbedres"
" ved det. Svar med en eller flere korte kommentarer, en pr. linje."

#: llm/static/js/modules/llm/editor.js:699
#, javascript-format
msgid ""
"Translate every sentence to %s. Do not improve or rewrite the text in the "
"original language."
msgstr ""
"Oversæt hver sætning til %s. Forbedre eller omskriv ikke teksten på "
"originalsproget."

#: llm/static/js/modules/llm/editor.js:705
msgid ""
"Return ONLY one or more short comments, one per line. Do not include these "
"instructions, the context, or any explanations. Do not rewrite the text."
msgstr ""
"Returner KUN en eller flere korte kommentarer, en pr. linje. Medtag ikke "
"disse instruktioner, konteksten eller nogen forklaringer. Du må ikke "
"omskrive teksten."

#: llm/static/js/modules/llm/editor.js:711
#, javascript-format
msgid ""
"Return ONLY the %s translation of the text below. Do not return any part of "
"it in the original language or any other language. Do not include these "
"instructions, the context, or any explanations. Do not quote the text. "
"Preserve all placeholders exactly."
msgstr ""
"Returner KUN %s oversættelsen af ​​teksten nedenfor. Returner ikke nogen del"
" af det på originalsproget eller noget andet sprog. Medtag ikke disse "
"instruktioner, konteksten eller nogen forklaringer. Citér ikke teksten. "
"Bevar alle pladsholdere nøjagtigt."

#: llm/static/js/modules/llm/editor.js:717
msgid ""
"Return ONLY the translation of the text below in the language requested "
"above. Do not return any part of it in the original language or any other "
"language. Do not include these instructions, the context, or any "
"explanations. Do not quote the text. Preserve all placeholders exactly."
msgstr ""
"Returner KUN oversættelsen af ​​teksten nedenfor på det sprog, der anmodes "
"om ovenfor. Returner ikke nogen del af det på originalsproget eller noget "
"andet sprog. Medtag ikke disse instruktioner, konteksten eller nogen "
"forklaringer. Citér ikke teksten. Bevar alle pladsholdere nøjagtigt."

#: llm/static/js/modules/llm/editor.js:722
msgid ""
"Return ONLY the improved version of the text below. If the text is already "
"correct and needs no changes, return it exactly as provided. Do not include "
"these instructions, the context, or any explanations in your response. Do "
"not quote the text. Preserve all placeholders exactly."
msgstr ""
"Returner KUN den forbedrede version af teksten nedenfor. Hvis teksten "
"allerede er korrekt og ikke skal ændres, skal du returnere den nøjagtigt som"
" angivet. Medtag ikke disse instruktioner, konteksten eller nogen "
"forklaringer i dit svar. Citér ikke teksten. Bevar alle pladsholdere "
"nøjagtigt."

#: llm/static/js/modules/llm/editor.js:726
msgid "TEXT TO IMPROVE:"
msgstr "TEKST TIL FORBEDRING:"

