msgstr "Използване на предоставен от сървъра API ключ"

#: llm/static/js/modules/llm/templates.js:169
msgid "Your API key"
msgstr "Вашият API ключ"

#: llm/static/js/modules/llm/templates.js:170
msgid "Leave empty to use the API key provided by the server operator."
msgstr ""
"Оставете празно, за да използвате API ключа, предоставен от оператора на "
"сървъра."

#: llm/static/js/modules/llm/templates.js:174
msgid "Fetch models"
msgstr "Извличане на модели"

#: llm/static/js/modules/llm/templates.js:179
msgid "Model"
msgstr "Модел"

#: llm/static/js/modules/llm/templates.js:181
msgid "Fetch models first"
msgstr "Първо вземете модели"

#: llm/static/js/modules/llm/templates.js:183
msgid "Or enter model name manually"
msgstr "Или въведете името на модела ръчно"
