msgstr "bloco de código"

#: llm/static/js/modules/llm/editor.js:117
msgid "LLM text improvement"
msgstr "Melhoria de texto LLM"

#: llm/static/js/modules/llm/editor.js:124
msgid "Improve entire text"
msgstr "Melhorar todo o texto"

#: llm/static/js/modules/llm/editor.js:127
