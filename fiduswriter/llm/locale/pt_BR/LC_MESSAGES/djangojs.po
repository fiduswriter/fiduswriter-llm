msgstr "Insira uma porcentagem válida de diferença de comprimento máximo."

#: llm/static/js/modules/llm/dialog.js:165
msgid "Please enter a valid minimum word difference percentage."
msgstr "Insira uma porcentagem mínima válida de diferença de palavras."

